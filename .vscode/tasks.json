{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate Video from Input",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/.vscode/generate_video_input.py"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Generate Demo Video",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/.vscode/generate_video_demo.py",
        "${workspaceFolder}/output"
      ],
      "group": {
        "kind": "build"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Open Output Folder",
      "type": "shell",
      "windows": {
        "command": "explorer",
        "args": [
          "${workspaceFolder}/output"
        ]
      },
      "osx": {
        "command": "open",
        "args": [
          "${workspaceFolder}/output"
        ]
      },
      "linux": {
        "command": "xdg-open",
        "args": [
          "${workspaceFolder}/output"
        ]
      },
      "group": "none",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "Clean Output Folder",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-Command",
          "Remove-Item -Path '${workspaceFolder}/output/*' -Force -ErrorAction SilentlyContinue; Write-Host 'Output folder cleaned'"
        ]
      },
      "group": "none",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Prompt for text input",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-Command",
          "Write-Host 'Ready to generate video. Run the Python script with your input text.'"
        ]
      },
      "group": "none",
      "presentation": {
        "reveal": "silent"
      }
    }
  ]
}
