{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Generate Video from Text",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/generate_video_input.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [],
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "preLaunchTask": "Prompt for text input"
    },
    {
      "name": "Generate Video Demo (Fixed Text)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/generate_video_demo.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["${workspaceFolder}/output"]
    },
    {
      "name": "Quick Video Generator",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/quick_generator.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  ]
}
